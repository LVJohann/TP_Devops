# Modèle traité au démarrage du conteneur par l'image nginx officielle (envsubst) :
# ${API_URL} est remplacé par la variable d'environnement du même nom.
#   - Docker Compose : http://api:8000
#   - Kubernetes     : http://api:80   (Service "api")
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # /api/xxx  ->  ${API_URL}/xxx  (le préfixe /api est retiré)
    location /api/ {
        proxy_pass ${API_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # La page Swagger servie sur /api/docs charge /openapi.json à la racine.
    location = /openapi.json {
        proxy_pass ${API_URL}/openapi.json;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
